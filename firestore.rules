rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if the user is the owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper to check if user is admin (you might need to adjust this based on your admin logic)
    // For now, we'll assume admins have a custom claim or are in a specific collection.
    // This is a placeholder. You should implement proper admin checks.
    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == "admin@artiva.com"; 
    }

    // Users: Users can read/write their own profile
    match /users/{userId} {
      allow read: if isAuthenticated();
      // TEMPORARY: Ultra-permissive for testing
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'photoUrl', 'updatedAt'])) || isAdmin();
      allow delete: if isAdmin();
      
      // Addresses subcollection
      match /addresses/{addressId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Favourites subcollection
      match /favourites/{favId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Notifications subcollection
      match /notifications/{notifId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }
    }


    // Artworks: everyone can read, only admin can create/delete
    // Authenticated users can update (e.g. for ratings)
    match /artworks/{artworkId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // Relaxed for debugging
      allow update: if isAuthenticated();
      
      // User ratings subcollection
      match /user_ratings/{orderId} {
        allow read: if true;
        // Allow write if the user owns the order or is admin
        allow write: if isAdmin() || (
          isAuthenticated() && 
          get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid
        );
      }
    }

    // Orders: Users can read/write their own orders
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Exhibitions: Public read, admin write
    match /exhibitions/{exhibitionId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // Allow customers to update bookedSeats during booking
      // Also allow auto-archiving if the date has passed (no auth required for system operation)
      allow update: if isAdmin() || 
        (
          isAuthenticated() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookedSeats'])
        ) ||
        (
          // Auto-archive: Allow if only changing isArchived/updatedAt and date has passed
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isArchived', 'updatedAt']) &&
          request.resource.data.isArchived == true &&
          resource.data.dateTime < request.time
        );
    }

    // Passes/Bookings: Users can read their own
    match /passes/{passId} {
      allow read: if isAuthenticated() && (resource.data.customerEmail == request.auth.token.email || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.customerEmail == request.auth.token.email;
      allow write: if isAdmin();
    }

    // Support Threads: Users can read/write their own thread, Admin can do anything
    match /support_threads/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
      
      match /messages/{messageId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Auctions: Public read, admin write
    match /auctions/{auctionId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || 
        (
          isAuthenticated() && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentBid', 'highestBidderId', 'highestBidderName', 'status']) &&
          request.resource.data.currentBid > resource.data.currentBid
        ) ||
        (
          isAuthenticated() &&
          resource.data.highestBidderId == request.auth.uid &&
          request.resource.data.status == 'sold'
        );

      // Bids subcollection
      match /bids/{bidId} {
        allow read: if true;
        // Authenticated users can place bids (validation happens in service, but rule allows write)
        allow create: if isAuthenticated();
        allow update, delete: if isAdmin();
      }
    }

    // Notifications: User read their own, admin write
    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
  }
}
